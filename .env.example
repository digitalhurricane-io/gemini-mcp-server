# Gemini API Key (required)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Port to expose on the host (default: 8000)
# Change this if port 8000 is already in use
# HOST_PORT=8080

# Optional: Set a specific project root for file sandboxing
# MCP_PROJECT_ROOT=/path/to/your/project

# Optional: Directory to mount in Docker container (default: $HOME)
# Use this to mount a specific directory instead of your entire home directory
# DOCKER_MOUNT_DIR=/path/to/mount/directory